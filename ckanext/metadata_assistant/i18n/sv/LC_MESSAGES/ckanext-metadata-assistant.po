#: ckanext/metadata_assistant/templates/metadata_assistant/admin/check_settings.html:61
#: ckanext/metadata_assistant/templates/metadata_assistant/admin/check_settings.html:84
msgid "On"
msgstr "På"

#: ckanext/metadata_assistant/templates/metadata_assistant/admin/check_settings.html:50
